#!/usr/bin/env ruby
# frozen_string_literal: true

# Runs the throwaway Redmine this plugin is tried in (docker-compose.yml, http://localhost:3015), with a fake Windmill.
#
#   ruby bin/demo up                 start both and load the demo data (once; running it again changes nothing)
#   ruby bin/demo seed               load the demo data into a Redmine that is already running
#   ruby bin/demo scenario <name>    switch what the fake Windmill reports: failures, all_green, hostile or unavailable
#   ruby bin/demo restart            restart Redmine, to pick up a change to the plugin
#   ruby bin/demo down               stop them, keep the data
#   ruby bin/demo reset              stop them and wipe the data
#
# Sign in as admin / admin, or as dana with demo-password-1. The status is at http://localhost:3015/status/windmill
# (the settings cache an answer for 5 seconds in the demo, so a new scenario shows after a few seconds).
require "net/http"

ROOT = File.expand_path("..", __dir__)
PORT = 3015
FAKE_WINDMILL_PORT = 9115
READY_SECONDS = 300
SEED_PATH = "plugins/redmine_rubylode_windmill/test/seed.rb"
SCENARIOS = %w[failures all_green hostile unavailable].freeze

def compose(*arguments)
  system("docker", "compose", *arguments, chdir: ROOT) || abort("docker compose #{arguments.join(' ')} failed")
end

def wait_until_ready
  uri = URI("http://localhost:#{PORT}/login")
  deadline = Time.now + READY_SECONDS
  loop do
    begin
      return puts("Redmine is up at http://localhost:#{PORT}") if Net::HTTP.get_response(uri).code == "200"
    rescue SystemCallError, EOFError, Net::ReadTimeout
      nil
    end
    abort("Redmine did not answer within #{READY_SECONDS} seconds") if Time.now > deadline
    sleep 3
  end
end

def seed
  compose("exec", "-T", "redmine", "bin/rails", "runner", SEED_PATH)
end

def switch_scenario(name)
  abort("scenario must be one of: #{SCENARIOS.join(', ')}") unless SCENARIOS.include?(name)
  response = Net::HTTP.post(URI("http://localhost:#{FAKE_WINDMILL_PORT}/__scenario/#{name}"), "")
  abort("the fake Windmill answered #{response.code}") unless response.code == "200"
  puts "The fake Windmill now reports: #{name}"
end

case ARGV.first
when "up"
  compose("up", "-d", "redmine", "fake_windmill")
  wait_until_ready
  seed
when "seed"
  seed
when "scenario"
  switch_scenario(ARGV[1].to_s)
when "restart"
  compose("restart", "redmine")
  wait_until_ready
when "down"
  compose("down")
when "reset"
  compose("down", "-v")
else
  abort(File.read(__FILE__)[/\A#!.*?\n\n((?:#.*\n)+)/m, 1].to_s.gsub(/^# ?/, ""))
end
